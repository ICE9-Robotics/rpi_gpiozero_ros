<?xml version="1.0"?>
<package format="3">
  <name>rpi5_gpiozero_ros</name>
  <version>0.1.0</version>
  <description>ROS 2 Jazzy package for Raspberry Pi 5 GPIO with gpiozero.</description>
  <maintainer email="anthony.jiang.github@outlook.com">anthony</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>ros_common_srvs</exec_depend>
  <exec_depend>python3-gpiozero</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
